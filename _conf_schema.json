{
  "enable_image": {"description": "启用图片与 GIF 功能", "type": "bool", "default": true},
  "enable_video": {"description": "启用视频功能", "type": "bool", "default": true},
  "enable_audio": {"description": "启用音频功能", "type": "bool", "default": true},
  "enable_mirage": {"description": "启用幻影坦克", "type": "bool", "default": true},
  "match_mode": {"description": "允许无斜杠精准关键词触发", "type": "bool", "default": false},
  "enable_at_avatar": {"description": "允许 @用户获取 QQ 头像", "type": "bool", "default": true},
  "max_image_mb": {"description": "图片/GIF大小上限(MB)", "type": "int", "default": 20},
  "max_video_mb": {"description": "视频大小上限(MB)", "type": "int", "default": 200},
  "max_audio_mb": {"description": "音频大小上限(MB)", "type": "int", "default": 50},
  "max_duration": {"description": "媒体最长时长(秒)", "type": "int", "default": 600},
  "process_timeout": {"description": "单任务超时(秒)", "type": "int", "default": 300},
  "heavy_concurrency": {"description": "视频音频重任务并发数", "type": "int", "default": 1},
  "ffmpeg_path": {"description": "FFmpeg可执行文件", "type": "string", "default": "ffmpeg"},
  "ffprobe_path": {"description": "FFprobe可执行文件", "type": "string", "default": "ffprobe"},
  "gif_max_fps": {"description": "GIF最高帧率", "type": "int", "default": 50},
  "gif_max_width": {"description": "GIF最大宽度", "type": "int", "default": 1920},
  "gif_speed_allow_frame_drop": {"description": "GIF超帧率时允许均匀丢帧", "type": "bool", "default": false},
  "mirage_timeout": {"description": "幻影坦克会话超时(秒)", "type": "int", "default": 60},
  "mirage_max_mb": {"description": "幻影坦克单图上限(MB)", "type": "int", "default": 10},
  "mirage_a": {"description": "里图亮度缩放", "type": "float", "default": 0.5},
  "mirage_b": {"description": "里图亮度偏移", "type": "float", "default": 20.0},
  "mirage_w": {"description": "里图颜色权重", "type": "float", "default": 0.1},
  "qq_private_file_first": {"description": "QQ转换优先私聊发送", "type": "bool", "default": true},
  "qq_group_file_enabled": {"description": "允许群聊发送文件", "type": "bool", "default": false},
  "qq_blocklist": {"description": "禁止转换功能的群号，逗号分隔", "type": "string", "default": ""},
  "debug": {"description": "调试日志", "type": "bool", "default": false}
}
